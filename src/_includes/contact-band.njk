<section class="section-tight contact-band" aria-labelledby="contact-h">
  <div class="wrap" style="display: flex; flex-wrap: wrap; gap: 32px 64px; align-items: center; justify-content: space-between;">
    <div style="flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 12px;">
      <p class="eyebrow">Contact</p>
      <h2 id="contact-h" class="display">Tell us about your project.</h2>
      <p class="lead">Licensed in multiple states. Ask if you need help somewhere new.</p>
    </div>
    <div style="display: flex; flex-direction: column; gap: 10px; flex: 0 1 360px; min-width: 0;">
      <a class="big-phone" href="tel:{{ site.phone_link }}">{{ site.phone }}</a>
      <span style="font-size: 15px;">{{ site.hours }}</span>
      <a class="btn btn-white" href="/contact/" style="align-self: flex-start; margin-top: 6px;">Send a Project Inquiry</a>
    </div>
  </div>
</section>
